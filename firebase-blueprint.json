{
  "entities": {
    "user_profile": {
      "title": "UserProfile",
      "description": "User viewing profile with independent watch history and preferences",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "description": "Display name of the profile"
        },
        "avatar": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Identifier for the selected avatar preset"
        },
        "color": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20,
          "description": "Accent hex color code for the profile"
        },
        "defaultAudio": {
          "type": "string",
          "enum": ["VOSTFR", "VF"],
          "description": "Preferred audio language for this profile"
        },
        "isKid": {
          "type": "boolean",
          "description": "Whether kid-safe filter is active"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the profile was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the profile was last modified"
        }
      },
      "required": ["name", "avatar", "color", "defaultAudio"]
    },
    "watchlist_item": {
      "title": "WatchlistItem",
      "description": "Saved anime in the user profile's watchlist",
      "type": "object",
      "properties": {
        "animeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Unique identifier of the saved anime"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Display title of the anime"
        },
        "posterImage": {
          "type": "string",
          "maxLength": 500,
          "description": "Poster artwork URL"
        },
        "keyVisual": {
          "type": "string",
          "maxLength": 500,
          "description": "Banner key visual URL"
        },
        "addedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when added to watchlist"
        }
      },
      "required": ["animeId", "title"]
    },
    "watch_progress": {
      "title": "WatchProgress",
      "description": "Real-time playback progress for an anime episode under a profile",
      "type": "object",
      "properties": {
        "animeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Identifier of the anime"
        },
        "episodeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150,
          "description": "Identifier of the episode"
        },
        "season": {
          "type": "number",
          "description": "Season number"
        },
        "number": {
          "type": "number",
          "description": "Episode number"
        },
        "currentTime": {
          "type": "number",
          "description": "Playback position in seconds"
        },
        "duration": {
          "type": "number",
          "description": "Total duration in seconds"
        },
        "completed": {
          "type": "boolean",
          "description": "Whether the episode has been watched until ending"
        },
        "animeTitle": {
          "type": "string",
          "maxLength": 200,
          "description": "Title of the anime"
        },
        "episodeTitle": {
          "type": "string",
          "maxLength": 200,
          "description": "Title of the episode"
        },
        "thumbnail": {
          "type": "string",
          "maxLength": 500,
          "description": "Thumbnail artwork URL for the episode"
        },
        "customVideoName": {
          "type": "string",
          "maxLength": 200,
          "description": "Optional custom loaded video filename"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of last playback update"
        }
      },
      "required": ["animeId", "episodeId", "currentTime", "duration", "completed"]
    }
  },
  "firestore": {
    "/profiles/{profileId}": {
      "schema": {
        "$ref": "#/entities/user_profile"
      },
      "description": "Shared viewing profiles synchronized across devices"
    },
    "/profiles/{profileId}/watchlist/{animeId}": {
      "schema": {
        "$ref": "#/entities/watchlist_item"
      },
      "description": "Independent anime watchlist items for each profile"
    },
    "/profiles/{profileId}/progress/{episodeId}": {
      "schema": {
        "$ref": "#/entities/watch_progress"
      },
      "description": "Independent second-by-second playback resume data per profile"
    }
  }
}
