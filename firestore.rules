rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidProfile(data) {
      return data.keys().hasAll(['name', 'avatar', 'color', 'defaultAudio']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 50 &&
        data.avatar is string && data.avatar.size() <= 60 &&
        data.color is string && data.color.size() <= 20 &&
        (data.defaultAudio == 'VOSTFR' || data.defaultAudio == 'VF');
    }

    function isValidWatchlist(data) {
      return data.keys().hasAll(['animeId', 'title']) &&
        data.animeId is string && data.animeId.size() <= 100 &&
        data.title is string && data.title.size() <= 200;
    }

    function isValidProgress(data) {
      return data.keys().hasAll(['animeId', 'episodeId', 'currentTime', 'duration', 'completed']) &&
        data.animeId is string && data.animeId.size() <= 100 &&
        data.episodeId is string && data.episodeId.size() <= 150 &&
        data.currentTime is number && data.duration is number &&
        data.completed is bool;
    }

    match /profiles/{profileId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(profileId) && isValidProfile(incoming());
      allow update: if isSignedIn() && isValidProfile(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'avatar', 'color', 'defaultAudio', 'isKid', 'updatedAt']);
      allow delete: if isSignedIn();

      match /watchlist/{animeId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() && isValidId(animeId) && isValidWatchlist(incoming());
        allow update: if isSignedIn() && isValidWatchlist(incoming()) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['animeId', 'title', 'posterImage', 'keyVisual', 'addedAt']);
        allow delete: if isSignedIn();
      }

      match /progress/{episodeId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() && isValidId(episodeId) && isValidProgress(incoming());
        allow update: if isSignedIn() && isValidProgress(incoming()) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'animeId', 'episodeId', 'season', 'number', 'currentTime',
            'duration', 'completed', 'animeTitle', 'episodeTitle',
            'thumbnail', 'customVideoName', 'updatedAt'
          ]);
        allow delete: if isSignedIn();
      }
    }
  }
}
